## 3️⃣ `admin/index.html` — Panel Admin (sin ir a otra página)

```html
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Panel Administrativo</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: Arial, sans-serif; background: #1a1a2e; color: #eee; padding: 20px; }
    h1 { text-align: center; color: #e94560; }
    .form-group { margin-bottom: 14px; }
    label { display: block; margin-bottom: 4px; font-size: 14px; }
    input, textarea {
      width: 100%; padding: 10px; border-radius: 8px;
      border: 1px solid #333; background: #16213e; color: #eee;
      font-size: 14px;
    }
    .preview-img {
      max-width: 200px; border-radius: 8px; margin-top: 8px;
      border: 2px dashed #e94560;
    }
    .btn-save {
      background: #e94560; color: white; border: none;
      padding: 12px 24px; border-radius: 8px; cursor: pointer;
      font-size: 16px; width: 100%; margin-top: 10px;
    }
    .btn-save:hover { background: #c73652; }
    .btn-close {
      position: absolute; top: 14px; right: 20px;
      background: transparent; color: #e94560;
      border: 1px solid #e94560; border-radius: 6px;
      padding: 6px 14px; cursor: pointer; font-size: 14px;
    }
    .items-list { margin-top: 30px; }
    .item-card {
      background: #16213e; border-radius: 10px;
      padding: 12px; margin-bottom: 10px;
      display: flex; align-items: center; gap: 12px;
    }
    .item-card img { width: 70px; height: 70px; object-fit: cover; border-radius: 8px; }
    .item-card .info { flex: 1; }
    .item-card .btn-del {
      background: #e94560; border: none; color: white;
      padding: 6px 12px; border-radius: 6px; cursor: pointer;
    }
    #status-msg {
      text-align: center; padding: 8px;
      border-radius: 8px; margin-top: 10px;
      display: none;
    }
    .success { background: #155724; color: #d4edda; display: block !important; }
    .error   { background: #721c24; color: #f8d7da; display: block !important; }
  </style>
</head>
<body>

<button class="btn-close" onclick="window.parent.document.getElementById('admin-overlay').classList.remove('active')">
  ✕ Cerrar
</button>

<h1>🍽️ Panel Administrativo</h1>

<!-- FORMULARIO DE NUEVO PLATO -->
<div class="form-group">
  <label>Nombre del plato</label>
  <input type="text" id="inp-name" placeholder="Ej: Lomo Saltado" />
</div>
<div class="form-group">
  <label>Descripción</label>
  <textarea id="inp-desc" rows="2" placeholder="Ingredientes, precio..."></textarea>
</div>
<div class="form-group">
  <label>Imagen del plato (se convierte en marcador AR)</label>
  <input type="file" id="inp-image" accept="image/*" onchange="previewImage(event)" />
  <img id="img-preview" class="preview-img" style="display:none;" />
</div>

<button class="btn-save" onclick="saveItem()">💾 Guardar y generar marcador</button>
<div id="status-msg"></div>

<!-- LISTA DE ITEMS GUARDADOS -->
<div class="items-list">
  <h3>Marcadores registrados</h3>
  <div id="items-container">Cargando...</div>
</div>

<script>
  // ─── PREVIEW DE IMAGEN ─────────────────────────────────────────
  function previewImage(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
      const img = document.getElementById('img-preview');
      img.src = e.target.result;
      img.style.display = 'block';
    };
    reader.readAsDataURL(file);
  }

  // ─── GUARDAR ITEM + SUBIR IMAGEN ──────────────────────────────
  async function saveItem() {
    const name    = document.getElementById('inp-name').value.trim();
    const desc    = document.getElementById('inp-desc').value.trim();
    const fileInp = document.getElementById('inp-image');
    const file    = fileInp.files[0];

    if (!name || !file) {
      showStatus('⚠️ Nombre e imagen son requeridos.', 'error');
      return;
    }

    const formData = new FormData();
    formData.append('name', name);
    formData.append('description', desc);
    formData.append('image', file);

    try {
      const res = await fetch('/api/items', { method: 'POST', body: formData });
      const data = await res.json();

      if (!res.ok) throw new Error(data.error || 'Error al guardar');

      showStatus(`✅ "${name}" guardado como marcador AR`, 'success');

      // Limpiar formulario
      document.getElementById('inp-name').value = '';
      document.getElementById('inp-desc').value = '';
      fileInp.value = '';
      document.getElementById('img-preview').style.display = 'none';

      loadItems();

      // ─── AVISAR AL INDEX.HTML PARA RECARGAR TARGETS ────────────
      window.parent.postMessage({ type: 'RELOAD_TARGETS' }, '*');

    } catch (err) {
      showStatus('❌ ' + err.message, 'error');
    }
  }

  // ─── CARGAR Y MOSTRAR ITEMS ───────────────────────────────────
  async function loadItems() {
    const container = document.getElementById('items-container');
    try {
      const res   = await fetch('/api/items');
      const items = await res.json();

      if (items.length === 0) {
        container.innerHTML = '<p style="color:#888">No hay platos registrados aún.</p>';
        return;
      }

      container.innerHTML = items.map(item => `
        <div class="item-card">
          <img src="${item.imagePath}" alt="${item.name}" />
          <div class="info">
            <strong>${item.name}</strong>
            <p style="margin:4px 0;font-size:13px;color:#aaa">${item.description || ''}</p>
          </div>
          <button class="btn-del" onclick="deleteItem('${item.id}')">🗑️</button>
        </div>
      `).join('');
    } catch (e) {
      container.innerHTML = '<p style="color:#e94560">Error cargando items.</p>';
    }
  }

  // ─── ELIMINAR ITEM ────────────────────────────────────────────
  async function deleteItem(id) {
    if (!confirm('¿Eliminar este marcador?')) return;
    await fetch(`/api/items/${id}`, { method: 'DELETE' });
    loadItems();
    window.parent.postMessage({ type: 'RELOAD_TARGETS' }, '*');
  }

  function showStatus(msg, type) {
    const el = document.getElementById('status-msg');
    el.textContent = msg;
    el.className = type;
    setTimeout(() => { el.className = ''; el.style.display = 'none'; }, 3500);
  }

  loadItems(); // Cargar al inicio
</script>
</body>
</html>
```

