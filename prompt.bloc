## 2️⃣ `js/ar-engine.js` — Motor AR con centrado automático

```javascript
// js/ar-engine.js
window.AREngine = (() => {

  // ─── CARGAR TARGETS DESDE LA API ──────────────────────────────
  async function loadTargets() {
    const res = await fetch('/api/items');
    const items = await res.json();
    return items;
  }

  // ─── INYECTAR ENTIDADES AR DINÁMICAMENTE ──────────────────────
  async function reloadTargets() {
    const items = await loadTargets();
    const scene = document.getElementById('arScene');
    const assets = document.getElementById('arAssets');

    // Limpiar entidades AR previas (no la cámara)
    scene.querySelectorAll('a-entity[mindar-image-target]').forEach(e => e.remove());
    assets.innerHTML = '';

    items.forEach((item, index) => {
      // Precargar imagen como asset
      const img = document.createElement('img');
      img.id = `img-${index}`;
      img.src = item.imagePath;    // e.g. /uploads/burger.jpg
      img.crossOrigin = 'anonymous';
      assets.appendChild(img);

      // Crear entidad target
      const entity = document.createElement('a-entity');
      entity.setAttribute('mindar-image-target', `targetIndex: ${index}`);

      // ─── CENTRADO AUTOMÁTICO ──────────────────────────────────
      // El plano se centra sobre el marcador con aspect ratio correcto
      const plane = document.createElement('a-plane');
      plane.setAttribute('src', `#img-${index}`);
      plane.setAttribute('position', '0 0 0');     // centrado exacto
      plane.setAttribute('rotation', '0 0 0');
      plane.setAttribute('width', '1');
      plane.setAttribute('height', '0.552');        // aspect 16:9 aprox
      plane.setAttribute('material', `src: #img-${index}; transparent: true; alphaTest: 0.1`);

      // Texto del nombre del plato debajo
      const text = document.createElement('a-text');
      text.setAttribute('value', item.name);
      text.setAttribute('position', '0 -0.35 0.01');
      text.setAttribute('align', 'center');
      text.setAttribute('color', '#ffffff');
      text.setAttribute('width', '1.5');
      text.setAttribute('font', 'https://cdn.aframe.io/fonts/Roboto-msdf.json');

      entity.appendChild(plane);
      entity.appendChild(text);
      scene.appendChild(entity);
    });

    console.log(`✅ ${items.length} marcadores cargados`);
  }

  // ─── INICIALIZAR ──────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    reloadTargets();

    // ─── ASEGURAR QUE LA CÁMARA FUNCIONE ─────────────────────────
    navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
      .then(stream => {
        console.log('✅ Cámara activa');
        stream.getTracks().forEach(t => t.stop()); // MindAR la toma sola
      })
      .catch(err => {
        alert('⚠️ Permite el acceso a la cámara para usar AR: ' + err.message);
      });
  });

  return { reloadTargets };
})();
```

